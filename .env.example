# Copy to .env and fill in. NEVER commit .env or paste keys in chat/screenshots.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=      # only if using temporary credentials
AWS_REGION=us-east-1
# Any Bedrock chat model you have access to (Converse API). Inference-profile IDs work too.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
